set -- "$?" "$@";eval "$(resource_ run_/preset)";[[ $1 =~ ^[0-9]+$ ]]&&set -- "$(LC_CTYPE=C tr -dc 'A-Za-z_'</dev/urandom|head -c16)" "$@";unset -f main_;eval 'local -i '"$WRD"'r="$1";shift;eval "$(resource_ run_/parse_opts)"||return "${1:-2}" 2>/dev/null;[[ MODE -eq 1||MODE -eq 2 ]] 2>/dev/null&&{ eval "$(resource_ run_/mkdir_out)"||return;};[[ -z $PRE ]]||{ [[ RSV -le 0 ]] 2>/dev/null||eval "$(recall_ run_/reserve)" "$PRE" $(eval '\''sed '\'\\\'\''s/[^_[:alnum:]]/  /g;s/ [0-9]\{1,\} //g'\'\\\'\''<<<" ${'\''"$PRE"'\''} " 2>/dev/null'\'');return_ "$'"$WRD"'r";eval '\''eval "${'\''"$PRE"'\''}"'\'\;"$1"'r="$?";};if [[ $# -eq 0 ]];then local -i '"$WRD"'z;[[ INTTRACE[2] -le ${#FUNCNAME[@]} ]]||INTTRACE[2]="${#FUNCNAME[@]}";INTTRACE="${#INTTAIL[@]}";INTTAIL+=("${#FUNCNAME[@]}");for((;;))do BKW=_BK"$((${BKW#_BK}+1))" BKR="$'"$WRD"'r" BKZ='"$WRD"'z eval "$(resource_ run_/break)";'"$WRD"'r="$?";[[ '"$WRD"'z -ge 0 ]]||eval "$BKX";break;done;else return_ "$'"$WRD"'r";"$@";'"$WRD"'r="$?";fi;[[ -z $PST ]]||{ [[ RSV -le 0 ]] 2>/dev/null||eval "$(recall_ run_/reserve)" "$PST" $(eval '\''sed '\'\\\'\''s/[^_[:alnum:]]/  /g;s/ [0-9]\{1,\} //g'\'\\\'\''<<<" ${'\''"$PST"'\''} " 2>/dev/null'\'');return_ "$'"$WRD"'r";eval '\''eval "${'\''"$PST"'\''}"'\'\;"$1"'r="$?";};return "$'"$WRD"'r"'
